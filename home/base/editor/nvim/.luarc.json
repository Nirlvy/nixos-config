{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "format.defaultConfig": {
    "indent_style": "space",
    "indent_size": "2"
  },
  "diagnostics.disable": [
    "duplicate-set-field"
  ],
  "diagnostics.globals": [
    "vim",
    "Snacks"
  ],
  "runtime.version": "LuaJIT",
  "workspace.library": [
    "${3rd}/luv/library"
  ]
}